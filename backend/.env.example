# =============================================================================
# backend/.env — copy this file to backend/.env and fill in the values.
#
# Nothing here is secret; backend/.env is gitignored and this file is not.
# Anything marked REQUIRED has no working default: the app starts without it
# and then fails at the first request that needs it.
# =============================================================================

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
MONGODB_URI=<paste your Atlas URI here>
MONGODB_DATABASE=ambedkargpt

# ── JWT (REQUIRED) ────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRY_MINUTES=30
REFRESH_TOKEN_EXPIRY_DAYS=7

# ── Post generation (REQUIRED) ────────────────────────────────────────────────
# DeepSeek writes the posts and runs the research step.
DEEPSEEK_API_KEY=<your DeepSeek key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-reasoner
# Writing is instruction-following, not deduction. On a reasoning model the
# chain-of-thought consumed the whole completion budget and returned an empty
# post; deepseek-chat does the same job in about a tenth of the time.
POST_GENERATION_MODEL=deepseek-chat
RESEARCH_MODEL=deepseek-chat

# ── Retrieval (REQUIRED) ──────────────────────────────────────────────────────
# Gemini embeds the query, Pinecone stores the chunks. Retrieval failure is not
# degraded past silently: the API returns 503 rather than an ungrounded post.
GEMINI_API_KEY=<your Gemini key>
EMBEDDING_MODEL=gemini-embedding-001
PINECONE_API_KEY=<your Pinecone key>
PINECONE_INDEX_NAME=ambedkargpt

# ── Web research (optional, off by default) ───────────────────────────────────
# Grounds posts in searched sources. Needs a reachable SearXNG:
#   docker compose -f deploy/searxng/docker-compose.yml up -d
# Leave WEB_RESEARCH_ENABLED unset to generate posts without the research step.
WEB_RESEARCH_ENABLED=
# Which search backend to use:
#   auto    SearXNG, falling back to Google CSE or DuckDuckGo (default)
#   searxng SearXNG only
#   google  Google Custom Search JSON API (no host needed; 100 queries/day free)
#   ddg     DuckDuckGo (no host, no key, no quota; narrower results)
# A laptop runs the SearXNG container and gets Google results through it. The
# Lambda has no container to talk to, so production sets google or ddg.
SEARCH_PROVIDER=auto
SEARXNG_URL=http://localhost:8080

# Google Custom Search. Key from console.cloud.google.com with the Custom
# Search API enabled; cx from programmablesearchengine.google.com, configured
# to search the entire web. One post spends one query per claim, so the free
# 100 a day is roughly thirty posts before it returns 429 and research goes
# quiet.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
# Only for a SearXNG reachable from the internet, where an ALB rule demands
# this header. Leave empty for a local container.
SEARXNG_AUTH_TOKEN=
# Reading pages needs trafilatura. Without it every source silently degrades to
# a one-line search snippet while the logs still report sources as verified:
#   pip install trafilatura
POST_VALIDATION_ENABLED=true

# ── Contact form email (REQUIRED for the landing form) ────────────────────────
# Gmail with an App Password, NOT the account password. Generate one at
# Google Account > Security > App passwords; 2-Step Verification must be on
# first or the option does not appear.
#
# Do not point this at a capture-only host such as sandbox.smtp.mailtrap.io:
# it accepts mail, shows it in a web UI, and never delivers. Verify with
#   python -m backend.scripts.check_contact_email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<the gmail address you send from>
SMTP_PASSWORD=<16-character app password, no spaces>
# Gmail rewrites From to the authenticated account, so keep the same address.
# A display name is fine: "AmbedkarGPT Contact Form <you@gmail.com>"
CONTACT_FROM_EMAIL=<same address as SMTP_USER>
CONTACT_RECIPIENT_EMAIL=<where contact submissions should land>

# ── Auth extras ───────────────────────────────────────────────────────────────
# Sign-in verifies the ID token client-side, so only the ID is needed. The
# client secret this file used to ask for is read nowhere in the backend.
GOOGLE_CLIENT_ID=<your Google OAuth client ID>
# SMS OTP provider. The Twilio keys this file used to list are no longer read.
TWOFACTOR_API_KEY=<your 2Factor API key>
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ── News ingestion ────────────────────────────────────────────────────────────
NEWS_API_KEY=<your NewsAPI key>
NEWS_COUNTRY=in
NEWS_PAGE_SIZE=20

# ── Web server ────────────────────────────────────────────────────────────────
# Comma separated. Unset falls back to '*', which is fine locally and not in
# production.
CORS_ORIGINS=http://localhost:5173
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# ── Dev helpers ───────────────────────────────────────────────────────────────
# Returns the OTP in the API response so signup works without SMS credentials.
# Never enable outside development.
AUTH_DEBUG_RETURN_OTP=true
# Writes every research run's prompts, results and pages to disk for inspection.
WEB_RESEARCH_DEBUG_DIR=

# --- Local development ---
VITE_API_URL=http://localhost:8000/api/v1
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- Shared test accounts (optional) ---
# Set this to the password from backend/scripts/seed_test_accounts.py and the
# login page shows a click-to-fill list of the three team accounts. Those
# accounts have no generation or publishing limits, so leave this unset on any
# build the public can reach -- the block does not render without it.
# VITE_TEST_PASSWORD=ask-the-team

# --- Production build (npm run build) ---
# Point to your public API origin (same host as Nginx / TLS).
# VITE_API_URL=https://api.example.com/api/v1
# VITE_GOOGLE_CLIENT_ID=your-production-google-client-id.apps.googleusercontent.com

# --- Google Analytics 4 (production only) ---
# The measurement ID from Analytics → Admin → Data streams → your web stream.
# Starts with "G-". Leave it unset everywhere else: without it, every call in
# src/analytics/ga.js is a no-op, so local work and preview builds never post
# into the property the real numbers live in.
#
# Set it in the host's build environment, not in a committed file.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

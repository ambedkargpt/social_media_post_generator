# ── Version control ──────────────────────────────────────────────────────────
.git
.gitignore

# ── Python bytecode ───────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
.env

# ── Frontend (not needed in backend containers) ───────────────────────────────
frontend/
frontend/node_modules/
frontend/.next/
frontend/out/

# ── Test artifacts ────────────────────────────────────────────────────────────
tests/
.pytest_cache/
.coverage
htmlcov/

# ── Local data + model caches (too large, downloaded from S3 at runtime) ──────
backend/data/*.json
backend/data/*.bin
backend/data/*.txt
backend/outputs/
outputs/

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.DS_Store
Thumbs.db

# ── Docs + planning files ─────────────────────────────────────────────────────
backend/docs/
*.md
!README.md

# ── Local dev configs ─────────────────────────────────────────────────────────
*.env
.env.*
docker-compose*.yml
